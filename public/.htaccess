# Passer on Apache. Static files only; the domain points at this folder.
# If a parent folder's .htaccess denies everything, this allows it again here.
Require all granted
Options -Indexes
DirectoryIndex index.html

# https only (service workers and the clipboard need a secure context)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Unknown paths open the index (each tool has its own folder with an index.html).
ErrorDocument 404 /index.html

AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), clipboard-write=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  # Once https works on the domain, uncomment:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build files never change; pages and the service worker always revalidate.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css|wasm|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest|version\.txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/wasm image/svg+xml
</IfModule>
